<Project>
  <PropertyGroup>
    <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">2.0.1-beta</ApplicationVersion>
    <ContainerVersion Condition="'$(ContainerVersion)' == ''">2.0.1-beta</ContainerVersion>
    <ContractsVersion Condition="'$(ContractsVersion)' == ''">2.0.1-beta</ContractsVersion>
    <RedisAdapterVersion Condition="'$(RedisAdapterVersion)' == ''">2.0.1-beta</RedisAdapterVersion>
    <AspNetCoreIntegrationVersion Condition="'$(AspNetCoreIntegrationVersion)' == ''">2.0.1-beta</AspNetCoreIntegrationVersion>
    <DotNetClientVersion Condition="'$(DotNetClientVersion)' == ''">2.0.1-beta</DotNetClientVersion>
    <BrowserPackageVersion Condition="'$(BrowserPackageVersion)' == ''">2.0.1-beta</BrowserPackageVersion>
    <HttpFallbackVersion Condition="'$(HttpFallbackVersion)' == ''">2.0.1-beta</HttpFallbackVersion>
    <HelmChartVersion Condition="'$(HelmChartVersion)' == ''">2.0.1-beta</HelmChartVersion>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <Authors>RealtimeStack Contributors</Authors>
    <Company>RealtimeStack</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl Condition="'$(PackageRepositoryUrl)' != ''">$(PackageRepositoryUrl)</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes Condition="'$(PackageReleaseNotesUrl)' != ''">$(PackageReleaseNotesUrl)</PackageReleaseNotes>
    <ContractsVersionCore>$([System.Text.RegularExpressions.Regex]::Replace('$(ContractsVersion)', '[-+].*$', ''))</ContractsVersionCore>
    <ContractsCompatibilityUpperBound Condition="'$(ContractsCompatibilityUpperBound)' == ''">$([System.Version]::Parse('$(ContractsVersionCore)').Major).$([MSBuild]::Add($([System.Version]::Parse('$(ContractsVersionCore)').Minor), 1)).0</ContractsCompatibilityUpperBound>
    <RedisAdapterVersionCore>$([System.Text.RegularExpressions.Regex]::Replace('$(RedisAdapterVersion)', '[-+].*$', ''))</RedisAdapterVersionCore>
    <RedisAdapterCompatibilityUpperBound Condition="'$(RedisAdapterCompatibilityUpperBound)' == ''">$([System.Version]::Parse('$(RedisAdapterVersionCore)').Major).$([MSBuild]::Add($([System.Version]::Parse('$(RedisAdapterVersionCore)').Minor), 1)).0</RedisAdapterCompatibilityUpperBound>
    <AspNetCoreIntegrationVersionCore>$([System.Text.RegularExpressions.Regex]::Replace('$(AspNetCoreIntegrationVersion)', '[-+].*$', ''))</AspNetCoreIntegrationVersionCore>
    <AspNetCoreIntegrationCompatibilityUpperBound Condition="'$(AspNetCoreIntegrationCompatibilityUpperBound)' == ''">$([System.Version]::Parse('$(AspNetCoreIntegrationVersionCore)').Major).$([MSBuild]::Add($([System.Version]::Parse('$(AspNetCoreIntegrationVersionCore)').Minor), 1)).0</AspNetCoreIntegrationCompatibilityUpperBound>
    <DotNetClientVersionCore>$([System.Text.RegularExpressions.Regex]::Replace('$(DotNetClientVersion)', '[-+].*$', ''))</DotNetClientVersionCore>
    <DotNetClientCompatibilityUpperBound>$([System.Version]::Parse('$(DotNetClientVersionCore)').Major).$([MSBuild]::Add($([System.Version]::Parse('$(DotNetClientVersionCore)').Minor), 1)).0</DotNetClientCompatibilityUpperBound>
    <BrowserPackageVersionCore>$([System.Text.RegularExpressions.Regex]::Replace('$(BrowserPackageVersion)', '[-+].*$', ''))</BrowserPackageVersionCore>
    <BrowserPackageCompatibilityUpperBound>$([System.Version]::Parse('$(BrowserPackageVersionCore)').Major).$([MSBuild]::Add($([System.Version]::Parse('$(BrowserPackageVersionCore)').Minor), 1)).0</BrowserPackageCompatibilityUpperBound>
    <HttpFallbackVersionCore>$([System.Text.RegularExpressions.Regex]::Replace('$(HttpFallbackVersion)', '[-+].*$', ''))</HttpFallbackVersionCore>
    <HttpFallbackCompatibilityUpperBound>$([System.Version]::Parse('$(HttpFallbackVersionCore)').Major).$([MSBuild]::Add($([System.Version]::Parse('$(HttpFallbackVersionCore)').Minor), 1)).0</HttpFallbackCompatibilityUpperBound>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <Import Project=".bootstrap/naming.props" Condition="Exists('.bootstrap/naming.props')" />
</Project>
