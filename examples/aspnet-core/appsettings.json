{
  "Gateway": {
    "ServiceName": "realtimestack-example"
  },
  "Redis": {
    "Endpoint": "127.0.0.1:6379",
    "InstancePrefix": "realtimestack:example"
  },
  "RealtimeStack": {
    "EndpointPath": "/realtimestack/ws",
    "TicketEndpointPath": "/realtimestack/tickets",
    "SessionSource": "AspNetCoreSession",
    "AspNetCoreSessionIdKey": "RealtimeStack.SessionId",
    "AllowedOrigins": [
      "http://127.0.0.1:5080"
    ]
  },
  "HttpFallback": {
    "BasePath": "/realtimestack/http",
    "ConnectionTimeoutSeconds": 30,
    "PollTimeoutSeconds": 10
  },
  "RealtimeStackSetup": {
    "GatewayEnabled": true,
    "HttpFallbackEnabled": true,
    "Persistence": {
      "Enabled": false,
      "ApiEnabled": false,
      "ApiBasePath": "/realtimestack/persistence",
      "Provider": "PostgreSql",
      "ConnectionStringName": "RealtimeStackPersistence",
      "TableName": "realtimestack_records",
      "CommandTimeoutSeconds": 30
    }
  }
}
