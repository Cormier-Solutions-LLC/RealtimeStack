{
	auto_https off
	admin off
	log default {
		output discard
	}
}

http://:{$PORT} {
	bind {$LISTEN_HOST}
	log {
		output discard
	}
	header {
		Cache-Control "no-store"
		Content-Security-Policy "default-src 'self'; connect-src 'self' ws: wss:; img-src 'self'; style-src 'self'; script-src 'self'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
	@realtimestack_websocket path /realtimestack/ws
	reverse_proxy @realtimestack_websocket {$GATEWAY_URL} {
		header_up Host {http.request.hostport}
		header_up X-Forwarded-Proto {$PUBLIC_SCHEME}
	}
	@realtimestack_http path /realtimestack/http/*
	reverse_proxy @realtimestack_http {$GATEWAY_URL} {
		header_up Host {http.request.hostport}
		header_up X-Forwarded-Proto {$PUBLIC_SCHEME}
		flush_interval -1
	}
	@bounded_request path /api/login /realtimestack/tickets
	request_body @bounded_request {
		max_size 65536
	}
	reverse_proxy unix//tmp/realtimestack-rails.sock
}
