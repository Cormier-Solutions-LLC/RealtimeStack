{
  "Gateway": {
    "ServiceName": "realtimestack-full-circle",
    "Topology": "non-ha",
    "ShutdownDrainSeconds": 2
  },
  "Redis": {
    "Endpoint": "127.0.0.1:16379",
    "InstancePrefix": "realtimestack:full-circle",
    "RequiredForReadiness": true
  },
  "RealtimeStack": {
    "EndpointPath": "/realtimestack/ws",
    "TicketEndpointPath": "/realtimestack/tickets",
    "SessionSource": "AspNetCoreSession",
    "AspNetCoreSessionIdKey": "RealtimeStack.SessionId",
    "AllowedOrigins": [
      "http://127.0.0.1:5080"
    ],
    "HeartbeatSeconds": 15,
    "IdleTimeoutSeconds": 45
  },
  "HttpFallback": {
    "BasePath": "/realtimestack/http",
    "ConnectionTimeoutSeconds": 30,
    "PollTimeoutSeconds": 10
  },
  "FullCircle": {
    "Topology": "non-ha",
    "InstanceName": "app-a",
    "SessionLifetimeMinutes": 20,
    "AllowedTenants": [
      "tenant-a",
      "tenant-b"
    ],
    "AllowedUsers": [
      "user-a",
      "user-b"
    ]
  },
  "RealtimeStackSetup": {
    "GatewayEnabled": true,
    "HttpFallbackEnabled": true,
    "Persistence": {
      "Enabled": false,
      "ApiEnabled": false,
      "ApiBasePath": "/realtimestack/persistence",
      "Provider": "PostgreSql",
      "ConnectionStringName": "RealtimeStackPersistence",
      "TableName": "realtimestack_records",
      "CommandTimeoutSeconds": 30
    }
  }
}
