{
  "Gateway": {
    "ServiceName": "realtime-full-circle",
    "Topology": "non-ha",
    "ShutdownDrainSeconds": 2
  },
  "Redis": {
    "Endpoint": "127.0.0.1:16379",
    "InstancePrefix": "realtime:full-circle",
    "RequiredForReadiness": true
  },
  "Realtime": {
    "EndpointPath": "/realtime/ws",
    "TicketEndpointPath": "/realtime/tickets",
    "SessionSource": "AspNetCoreSession",
    "AspNetCoreSessionIdKey": "Realtime.SessionId",
    "AllowedOrigins": [
      "http://127.0.0.1:5080"
    ],
    "HeartbeatSeconds": 15,
    "IdleTimeoutSeconds": 45
  },
  "HttpFallback": {
    "BasePath": "/realtime/http",
    "ConnectionTimeoutSeconds": 30,
    "PollTimeoutSeconds": 10
  },
  "FullCircle": {
    "Topology": "non-ha",
    "InstanceName": "app-a",
    "SessionLifetimeMinutes": 20,
    "AllowedTenants": [
      "tenant-a",
      "tenant-b"
    ],
    "AllowedUsers": [
      "user-a",
      "user-b"
    ]
  },
  "RealtimeSetup": {
    "GatewayEnabled": true,
    "HttpFallbackEnabled": true,
    "Persistence": {
      "Enabled": false,
      "ApiEnabled": false,
      "ApiBasePath": "/realtime/persistence",
      "Provider": "PostgreSql",
      "ConnectionStringName": "RealtimePersistence",
      "TableName": "realtime_records",
      "CommandTimeoutSeconds": 30
    }
  }
}
