<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <UseProjectReferences Condition="'$(UseProjectReferences)' == ''">true</UseProjectReferences>
  </PropertyGroup>

  <PropertyGroup>
    <ReferenceAssetRoot Condition="'$(Configuration)' == 'Release'">..\shared-web\dist\optimized</ReferenceAssetRoot>
    <ReferenceAssetRoot Condition="'$(ReferenceAssetRoot)' == ''">..\shared-web\wwwroot</ReferenceAssetRoot>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseProjectReferences)' == 'true'">
    <ProjectReference Include="..\..\src\Realtime.AspNetCore\Realtime.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\Realtime.HttpFallback\Realtime.HttpFallback.csproj" />
    <ProjectReference Include="..\..\src\Realtime.Browser\Realtime.Browser.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseProjectReferences)' != 'true'">
    <PackageReference Include="Realtime.AspNetCore" Version="$(AspNetCoreIntegrationVersion)" />
    <PackageReference Include="Realtime.HttpFallback" Version="$(HttpFallbackVersion)" />
    <PackageReference Include="Realtime.Browser" Version="$(BrowserPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(ReferenceAssetRoot)\**\*"
             Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <ProjectReference Condition="'$(UseProjectReferences)' == 'true'" Include="../../src/Realtime.Config/Realtime.Config.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseProjectReferences)' != 'true'">
    <PackageReference Include="Realtime.Config" Version="$(ContractsVersion)" />
  </ItemGroup>
</Project>
