<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <VersionPrefix>$(ContractsVersion)</VersionPrefix>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <RuntimeFrameworkVersion Condition="'$(TargetFramework)' == 'net10.0'">10.0.14</RuntimeFrameworkVersion>
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net10.0'">true</IsAotCompatible>
    <PackageId>RealtimeStack.Plugins.Logging</PackageId>
    <Description>Shared provider-neutral error handling and registration for RealtimeStack logging plugins.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Explicit null/range guards also compile for .NET Standard 2.0. -->
    <NoWarn>$(NoWarn);CS1591;CA1510;CA1512</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[10.0.14,11.0.0)" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
