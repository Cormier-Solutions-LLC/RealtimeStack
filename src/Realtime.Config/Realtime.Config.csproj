<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <VersionPrefix>$(ContractsVersion)</VersionPrefix>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <IsPackable>true</IsPackable><PackageId>Realtime.Config</PackageId>
    <Description>Registration, setup inspection, and first-run configuration for Realtime systems and database plugins.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile><NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup><FrameworkReference Include="Microsoft.AspNetCore.App" /></ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Realtime.AspNetCore/Realtime.AspNetCore.csproj" />
    <ProjectReference Include="../Realtime.Browser/Realtime.Browser.csproj" />
    <ProjectReference Include="../Realtime.Client/Realtime.Client.csproj" />
    <ProjectReference Include="../Realtime.Contracts/Realtime.Contracts.csproj" />
    <ProjectReference Include="../Realtime.HttpFallback/Realtime.HttpFallback.csproj" />
    <ProjectReference Include="../Realtime.Redis/Realtime.Redis.csproj" />
    <ProjectReference Include="../Realtime.Plugins.AzureSql/Realtime.Plugins.AzureSql.csproj" />
    <ProjectReference Include="../Realtime.Plugins.CockroachDb/Realtime.Plugins.CockroachDb.csproj" />
    <ProjectReference Include="../Realtime.Plugins.Db2/Realtime.Plugins.Db2.csproj" />
    <ProjectReference Include="../Realtime.Plugins.MariaDb/Realtime.Plugins.MariaDb.csproj" />
    <ProjectReference Include="../Realtime.Plugins.MySql/Realtime.Plugins.MySql.csproj" />
    <ProjectReference Include="../Realtime.Plugins.Oracle/Realtime.Plugins.Oracle.csproj" />
    <ProjectReference Include="../Realtime.Plugins.Persistence/Realtime.Plugins.Persistence.csproj" />
    <ProjectReference Include="../Realtime.Plugins.PostgreSql/Realtime.Plugins.PostgreSql.csproj" />
    <ProjectReference Include="../Realtime.Plugins.Snowflake/Realtime.Plugins.Snowflake.csproj" />
    <ProjectReference Include="../Realtime.Plugins.Sqlite/Realtime.Plugins.Sqlite.csproj" />
    <ProjectReference Include="../Realtime.Plugins.SqlServer/Realtime.Plugins.SqlServer.csproj" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
